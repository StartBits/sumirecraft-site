{
  "$schema": "https://raw.githubusercontent.com/dotnet/docfx/main/schemas/docfx.schema.json",
  "metadata": [
    {
      "src": [
        {
          "src": "external/SumireCraft.Maui/src",
          "files": [
            "**/*.csproj"
          ]
        }
      ],
      "dest": "api",
      "properties": {
        "TargetFramework": "net10.0"
      }
    }
  ],
  "build": {
    "content": [
      {
        "files": [
          "index.md",
          "toc.yml",
          "docs/**/*.{md,yml}",
          "api/**/*.{md,yml}"
        ]
      }
    ],
    "resource": [
      {
        "src": "external/SumireCraft.Maui/assets",
        "files": [
          "*.png",
          "*.gif"
        ],
        "dest": "images"
      },
      {
        "src": "external/SumireCraft.Maui/build",
        "files": [
          "icon.png"
        ],
        "dest": "images"
      }
    ],
    "output": "_site",
    "template": [
      "default",
      "modern"
    ],
    "globalMetadata": {
      "_appName": "SumireCraft",
      "_appTitle": "SumireCraft",
      "_appLogoPath": "images/icon.png",
      "_appFaviconPath": "images/icon.png",
      "_appFooter": "SumireCraft is made by StartBits.",
      "_enableSearch": true,
      "_disableContribution": true
    },
    "sitemap": {
      "baseUrl": "https://startbits.github.io/sumirecraft-site/"
    }
  }
}
